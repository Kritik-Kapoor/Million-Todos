generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  username String
  email String @unique
  password String
  isEmailVerified Boolean @default(false)
  dueDateReminder Boolean @default(true)
  dailyDigest Boolean @default(false)
  createdAt DateTime @default(now())
  todos Todo[]
  labels Label[]
  tokens UserTokens[]
}

model UserTokens {
  id String @id @default(uuid())
  userId String
  type TokenType
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Todo {
  seq Int @unique @default(autoincrement())
  id String @id @default(uuid())
  userId String
  title String
  description String?
  completed Boolean  @default(false)
  dueDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subtaskCount Int @default(0)
  hasLabels Boolean @default(false)
  lastReminderAt DateTime?
  subtasks Subtask[]
  labels TodoLabel[]
  reminders TodoReminder[]
  search_vector Unsupported("tsvector")?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, hasLabels, seq])
  @@index([search_vector], type: Gin, map: "todo_search_vector_idx")
}

model Subtask {
  id String @id @default(uuid())
  todoId String
  title String
  completed Boolean @default(false)
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  @@index([todoId, position])
}

model Label {
  id String @id @default(uuid())
  userId String
  name String
  color String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos TodoLabel[]
  @@unique([userId, name])
  @@index([userId])
}

model TodoLabel {
  todoId String
  labelId String
  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  @@id([todoId, labelId])
  @@index([labelId])
}

model TodoReminder {
  id String @id @default(uuid())
  todoId String
  type ReminderType
  channel ReminderChannel
  reminderDate DateTime
  createdAt DateTime @default(now())
  sentAt DateTime?
  status ReminderStatus
  providerMessageId String?
  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  @@index([todoId, type, channel])
}

enum ReminderType {
  DUE_6_HOURS
  DAY_SUMMARY
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum ReminderChannel {
  EMAIL
  SMS
}