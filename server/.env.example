# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/million_todos?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Token Expiration
RESET_PASSWORD_EXPIRES_IN="15m"
EMAIL_VERIFICATION_EXPIRES_IN="1h"

# Frontend URL
WEBAPP_URL=http://localhost:3000

# Resend
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="onboarding@resend.dev"

# Cron (external scheduler auth — separate from JWT_SECRET)
CRON_SECRET="your-cron-secret"